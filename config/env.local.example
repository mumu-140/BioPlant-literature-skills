# 公开示例：请复制到 `local/.env.local` 后再填写真实值，不要把真实密钥提交到仓库。
# 变量名必须与本机 YAML 配置里声明的 `*_env` 字段保持一致。

# Google Translation Basic v2 API Key
GOOGLE_TRANSLATE_API_KEY=

# 腾讯云机器翻译主账号密钥
TENCENT_TMT_SECRET_ID=
TENCENT_TMT_SECRET_KEY=

# 腾讯云临时凭证令牌；如果不用临时凭证，可留空
TENCENT_TMT_SESSION_TOKEN=

# 主 SMTP 发件账号的授权码 / App Password
SMTP_APP_PASSWORD=

# 备用 SMTP 发件账号的授权码 / App Password；不用备用账号可留空
SMTP_BACKUP_APP_PASSWORD=

# 可选：外部 LLM 审核服务 API Key
LLM_REVIEW_API_KEY=
